<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AU26_Counter.Views.CounterPage"
             xmlns:models="clr-namespace:AU26_Counter.Models"
             x:DataType="models:Counter"
             Title="Counter">

    <ScrollView>
        <VerticalStackLayout
        Padding="30,0"
        Spacing="25">

            <Entry 
                x:Name="CounterName"
                Text="{Binding Text}"
                Placeholder="Enter a name for the counter"
                HeightRequest="100"
                FontSize="25" 
                TextChanged="NameChanged"/>

            <Label 
                x:Name="cntr"
                Text="{Binding CountValue}"
                FontSize="120"
                Padding="20"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />


            <HorizontalStackLayout
            Padding="15"
            Spacing="20"
            HorizontalOptions="Center">
                
                <Button
                    x:Name="CounterAddBtn"
                    Text="+1"
                    Clicked="OnCounterAddClicked" />

                    <Button
                    x:Name="CounterSubBtn"
                    Text="-1"
                    Clicked="OnCounterDecreaseClicked" />
            </HorizontalStackLayout>
            

            <Button x:Name="ReturnButton"
                    Text="Return to counters page"
                    Clicked="returnButtonClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>